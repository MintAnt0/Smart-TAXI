<?xml version="1.0"?>
<ruleset name="SmartTaxi">
    <description>
        Règles de style et de sécurité du projet Smart Taxi.
        Adapté au code existant : application PHP procédurale
        où chaque fichier .php est une page « contrôleur ».
    </description>

    <!-- Fichiers analysés -->
    <file>.</file>

    <!-- Emplacements exclus -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/PHPMailer-master/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/.git/*</exclude-pattern>

    <!-- Arguments -->
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!--
        Niveaux de gravité
        1 = erreur      -> fait échouer le hook et la CI
        5 = avertissement -> affiché, ne fait pas échouer
    -->
    <arg name="warning-severity" value="5"/>

    <!--
        Standard de référence : PSR-12, amputé des règles inapplicables
        à une application procédurale de pages.
    -->
    <rule ref="PSR12">
        <!-- Chaque page .php exécute du code : c'est le but du fichier,
             pas une faute. -->
        <exclude name="PSR1.Files.SideEffects"/>

        <!-- Pas d'espace de noms ni d'en-tête de licence dans ce projet. -->
        <exclude name="PSR12.Files.FileHeader"/>
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock"/>
        <exclude name="PSR12.Files.FileHeader.IncorrectOrder"/>
        <exclude name="PSR12.Files.FileHeader.MissingEmptyLineAfterBlock"/>

        <!-- « <?php » suivi de code sur la même ligne est toléré. -->
        <exclude name="PSR12.Files.OpenTag.NotAlone"/>
    </rule>

    <!--
        Un commentaire intercalé entre « } » et « elseif » est toléré
        : Inscription.php commente chaque cas de validation. Le sniff exige
        sinon « } elseif » sur une seule ligne.
    -->
    <rule ref="Squiz.ControlStructures.ControlSignature.SpaceAfterCloseBrace">
        <severity>0</severity>
    </rule>

    <!--
        Longueur de ligne non imposée : les pages HTML inlinées dans les
        fichiers .php dépassent largement 120 caractères. À réintroduire
        lorsque le code sera séparé en vues (templates).
    -->
    <rule ref="Generic.Files.LineLength">
        <exclude name="Generic.Files.LineLength"/>
    </rule>

    <!--
        Sécurité : fonctions dangereuses interdites.
        Réf. guides ANSSI (mesures cyber préventives prioritaires).
    -->
    <rule ref="Generic.PHP.ForbiddenFunctions">
        <properties>
            <property name="forbiddenFunctions" type="array">
                <element key="eval" value="eval"/>
                <element key="exec" value="exec"/>
                <element key="shell_exec" value="shell_exec"/>
                <element key="system" value="system"/>
                <element key="passthru" value="passthru"/>
                <element key="popen" value="popen"/>
                <element key="proc_open" value="proc_open"/>
                <element key="unserialize" value="unserialize"/>
                <element key="extract" value="extract"/>
                <element key="assert" value="assert"/>
                <element key="create_function" value="create_function"/>
            </property>
        </properties>
    </rule>

    <!--
        Sécurité : concaténation de variables dans une chaîne HTML
        — vecteur classique d'injection.
    -->
    <rule ref="Generic.PHP.ForbiddenFunctions"/>
    <rule ref="Generic.Files.EndFileNewline"/>
    <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>
    <rule ref="Squiz.PHP.EmbeddedPhp"/>

    <!--
        Les marqueurs TODO / FIXME ne bloquent pas la CI.
    -->
    <rule ref="Generic.Commenting.Todo.CommentFound">
        <severity>0</severity>
    </rule>
</ruleset>
